# Salin menjadi .env lalu isi. Jangan commit .env.
# Variabel environment asli (mis. dari panel hosting) selalu menang atas isi file ini.

# development | staging | production | testing
APP_ENV=development

# Origin front-end yang boleh mengirim request yang mengubah data (cek header Origin).
# Pisahkan dengan koma. Di production wajib https.
APP_ALLOWED_ORIGINS=http://localhost:8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jastip
DB_USER=jastip
DB_PASSWORD=

# Cookie sesi Secure (HTTPS). Hanya boleh false untuk lokal tanpa HTTPS; ditolak di production.
SESSION_COOKIE_SECURE=false
# Sesi berakhir setelah sekian menit tidak aktif (12 jam).
SESSION_IDLE_MINUTES=720

# Batas login gagal per nama pengguna per jendela waktu.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

KURS_API_URL=https://api.frankfurter.dev/v2/rate/aud/idr
KURS_TIMEOUT_SECONDS=5

# Path relatif terhadap folder backend/, atau absolut, atau php://stderr
LOG_PATH=storage/logs/app.log
