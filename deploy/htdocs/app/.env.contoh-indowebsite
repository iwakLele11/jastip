# Contoh konfigurasi untuk Indowebsite (cPanel) atau hosting cPanel lain dengan HTTPS.
# Salin file ini menjadi file bernama .env di folder yang sama (app/.env), lalu ganti
# SEMUA nilai yang ditulis GANTI_... dengan data dari cPanel.
# Jangan pernah mengirim isi file .env ke orang lain: isinya password database.

APP_ENV=production

# Alamat situs persis seperti di address bar: diawali https://, tanpa garis miring di akhir.
# Kalau situs juga dibuka lewat www, tulis keduanya dipisah koma:
#   APP_ALLOWED_ORIGINS=https://bagasimel.my.id,https://www.bagasimel.my.id
APP_ALLOWED_ORIGINS=https://bagasimel.my.id

# Data dari cPanel, halaman "MySQL Databases".
# Di cPanel, DB_HOST hampir selalu "localhost" (BUKAN seperti InfinityFree).
# Nama database dan user biasanya berawalan nama akun cPanel, contoh: namaakun_jastip.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=GANTI_namaakun_jastip
DB_USER=GANTI_namaakun_jastip
DB_PASSWORD=GANTI_PASSWORD_MYSQL

# HTTPS wajib: cookie sesi hanya dikirim lewat https. Jangan diubah ke false.
SESSION_COOKIE_SECURE=true
# Sesi berakhir setelah sekian menit tidak aktif (12 jam).
SESSION_IDLE_MINUTES=720

# Batas login gagal per nama pengguna dan per IP per jendela waktu (menit).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_ATTEMPTS_PER_IP=20

KURS_API_URL=https://api.frankfurter.dev/v2/rate/aud/idr
KURS_TIMEOUT_SECONDS=5

# Relatif terhadap folder app/
LOG_PATH=storage/logs/app.log
