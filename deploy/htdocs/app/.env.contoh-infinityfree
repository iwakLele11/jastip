# Contoh konfigurasi untuk InfinityFree (atau hosting lain dengan HTTPS).
# Salin file ini menjadi file bernama .env di folder yang sama (app/.env), lalu ganti
# SEMUA nilai yang ditulis GANTI_... dengan data dari client area InfinityFree.
# Jangan pernah mengirim isi file .env ke orang lain: isinya password database.

APP_ENV=production

# Alamat situs persis seperti di address bar: diawali https://, tanpa garis miring di akhir.
#   Subdomain gratis : APP_ALLOWED_ORIGINS=https://jastipku.rf.gd   (www tidak didukung)
#   Domain sendiri   : APP_ALLOWED_ORIGINS=https://jastipku.com,https://www.jastipku.com
APP_ALLOWED_ORIGINS=https://GANTI_DOMAIN_ANDA

# Data dari client area InfinityFree, halaman MySQL Databases (bukan "localhost").
#   DB_HOST contoh: sql123.infinityfree.com
#   DB_NAME contoh: if0_12345678_jastip
#   DB_USER contoh: if0_12345678
DB_HOST=GANTI_sqlXXX.infinityfree.com
DB_PORT=3306
DB_NAME=GANTI_if0_XXXXXXXX_jastip
DB_USER=GANTI_if0_XXXXXXXX
DB_PASSWORD=GANTI_PASSWORD_MYSQL

# HTTPS wajib: cookie sesi hanya dikirim lewat https. Jangan diubah ke false.
SESSION_COOKIE_SECURE=true
# Sesi berakhir setelah sekian menit tidak aktif (12 jam).
SESSION_IDLE_MINUTES=720

# Batas login gagal per nama pengguna per jendela waktu (menit).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

KURS_API_URL=https://api.frankfurter.dev/v2/rate/aud/idr
KURS_TIMEOUT_SECONDS=5

# Relatif terhadap folder app/
LOG_PATH=storage/logs/app.log
