# Contoh konfigurasi untuk XAMPP di laptop (http://localhost).
# Salin file ini menjadi file bernama .env di folder yang sama (app\.env).
# Nilai di bawah sudah cocok dengan XAMPP bawaan (user root tanpa password, database "jastip").

APP_ENV=development

# Alamat yang dipakai untuk membuka aplikasi, dipisah koma, tanpa garis miring di akhir.
# Kalau juga dibuka dari HP lewat Wi-Fi, tambahkan IP laptop, contoh:
#   APP_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://192.168.1.10
APP_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jastip
DB_USER=root
DB_PASSWORD=

# Lokal tanpa HTTPS: false. (Di hosting dengan HTTPS wajib true.)
SESSION_COOKIE_SECURE=false
# Sesi berakhir setelah sekian menit tidak aktif (12 jam).
SESSION_IDLE_MINUTES=720

# Batas login gagal per nama pengguna dan per IP per jendela waktu (menit).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_ATTEMPTS_PER_IP=20

KURS_API_URL=https://api.frankfurter.dev/v2/rate/aud/idr
KURS_TIMEOUT_SECONDS=5

# Relatif terhadap folder app\
LOG_PATH=storage/logs/app.log
